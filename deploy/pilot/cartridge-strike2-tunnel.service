[Unit]
Description=Temporary HTTPS and WSS tunnel for Cartridge-Strike 2
Wants=network-online.target cartridge-strike2-pilot.service
After=network-online.target cartridge-strike2-pilot.service
ConditionPathExists=/etc/cartridge-strike2-pilot/until

[Service]
DynamicUser=yes
RuntimeDirectory=cartridge-strike2-tunnel
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/cartridge-strike2-pilot/current/deploy/pilot/quick-tunnel.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
MemoryMax=384M
TasksMax=128
LimitNOFILE=2048
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
